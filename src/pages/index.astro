---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, PROFILE } from '../consts';

import { education, experience, projects } from '../resume';

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Intro -->
			<section class="flex flex-col-reverse gap-8 sm:flex-row sm:items-center">
				<div class="flex-1">
					<h1 class="mb-2 text-3xl sm:text-4xl">{PROFILE.name}</h1>
					<div class="mt-4 space-y-1 text-[0.95rem]">
						<p class="m-0">
							Email: <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
						</p>
						<p class="m-0">
							Tel: <span class="text-[rgb(var(--gray))]">{PROFILE.phone}</span>
						</p>
						<div class="mt-2 flex items-center gap-4">
							<a
								href={`mailto:${PROFILE.email}`}
								aria-label="Email"
								class="text-[rgb(var(--gray-dark))] transition-colors hover:text-[rgb(var(--accent))]"
							>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
									<rect x="3" y="5" width="18" height="14" rx="2"></rect>
									<path d="m3 7 9 6 9-6"></path>
								</svg>
							</a>
							<a
								href={PROFILE.linkedin}
								target="_blank"
								rel="noopener"
								aria-label="LinkedIn"
								class="text-[rgb(var(--gray-dark))] transition-colors hover:text-[rgb(var(--accent))]"
							>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path
										d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
									/>
								</svg>
							</a>
							<a
								href={PROFILE.github}
								target="_blank"
								rel="noopener"
								aria-label="GitHub"
								class="text-[rgb(var(--gray-dark))] transition-colors hover:text-[rgb(var(--accent))]"
							>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path
										d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.49 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58C20.57 22.3 24 17.8 24 12.5 24 5.87 18.63.5 12 .5z"
									/>
								</svg>
							</a>
						</div>
					</div>
				</div>
				<img
					src="/profile.jpg"
					alt={PROFILE.name}
					width="112"
					height="112"
					class="h-28 w-28 shrink-0 rounded-full border border-[rgb(var(--gray-light))] object-cover"
				/>
			</section>

			<!-- Bio -->
			<section class="mt-10 space-y-4 text-[1.05rem] leading-relaxed">
				<p class="m-0">
					I am a Master of Computing student at the National University of Singapore, with a
					background in information systems and statistics. My work spans applied AI, agent
					evaluation, machine learning, and data systems. I am interested in quantitative research
					and the application of AI to quantitative finance. I have worked at Thales, JD,
					Meituan, and 6Estates.
				</p>
			</section>

			<!-- Education -->
			<section class="mt-12">
				<h2 class="border-b border-[rgb(var(--gray-light))] pb-1 text-2xl">Education</h2>
				<div class="mt-5 space-y-6">
					{
						education.map((e) => (
							<div>
								<div class="flex flex-wrap items-baseline justify-between gap-x-3">
									<h3 class="m-0 text-base">
										{e.link ? (
											<a href={e.link} target="_blank" rel="noopener">
												{e.school}
											</a>
										) : (
											e.school
										)}
									</h3>
									<span class="text-sm text-[rgb(var(--gray))]">{e.place}</span>
								</div>
								<div class="flex flex-wrap items-baseline justify-between gap-x-3">
									<p class="m-0 text-[1.02rem]">{e.degree}</p>
									<span class="text-sm text-[rgb(var(--gray))]">{e.dates}</span>
								</div>
								{e.notes.length > 0 && (
									<ul class="mt-2 list-disc space-y-1 pl-5 text-[0.95rem] text-[rgb(var(--gray-dark))]">
										{e.notes.map((n) => (
											<li>{n}</li>
										))}
									</ul>
								)}
							</div>
						))
					}
				</div>
			</section>

			<!-- Experience -->
			<section class="mt-12">
				<h2 class="border-b border-[rgb(var(--gray-light))] pb-1 text-2xl">Experience</h2>
				<div class="mt-5 space-y-7">
					{
						experience.map((x) => (
							<div>
								<div class="flex flex-wrap items-baseline justify-between gap-x-3">
									<h3 class="m-0 text-xl">
										{x.role},{' '}
										<span class="font-normal">
											{x.link ? (
												<a href={x.link} target="_blank" rel="noopener">
													{x.org}
												</a>
											) : (
												x.org
											)}
										</span>
									</h3>
									<span class="text-sm text-[rgb(var(--gray))]">{x.dates}</span>
								</div>
								<p class="m-0 text-sm text-[rgb(var(--gray))]">{x.place}</p>
								<ul class="mt-2 list-disc space-y-2 pl-5 text-[1.02rem] leading-relaxed">
									{x.points.map((p) => (
										<li>{p}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- Projects -->
			<section class="mt-12">
				<h2 class="border-b border-[rgb(var(--gray-light))] pb-1 text-2xl">Projects</h2>
				<div class="mt-5 space-y-7">
					{
						projects.map((p) => (
							<div>
								<div class="flex flex-wrap items-baseline justify-between gap-x-3">
									<h3 class="m-0 text-base">
										{p.link ? (
											<a href={p.link} target="_blank" rel="noopener">
												{p.title}
											</a>
										) : (
											p.title
										)}
									</h3>
									<span class="text-sm text-[rgb(var(--gray))]">{p.date}</span>
								</div>
								<p class="m-0 text-sm italic text-[rgb(var(--gray))]">{p.tag}</p>
								<ul class="mt-2 list-disc space-y-2 pl-5 text-[1.02rem] leading-relaxed">
									{p.points.map((pt) => (
										<li>{pt}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
