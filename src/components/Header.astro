---
import { SITE_TITLE } from '../consts';
---

<header class="border-b border-[rgb(var(--gray-light))] bg-[var(--paper)]">
	<nav class="mx-auto flex w-full max-w-[900px] items-center justify-between gap-4 px-5 py-4">
		<a
			href="/"
			class="font-serif text-lg font-medium tracking-tight text-[rgb(var(--black))] no-underline"
		>
			{SITE_TITLE}
		</a>
	</nav>
</header>
<style>
	nav :global(a) {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	nav :global(a:hover) {
		color: var(--accent);
	}
	nav :global(a.active) {
		color: var(--accent);
		font-weight: 600;
	}
</style>
